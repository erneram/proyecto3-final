{
  "name": "compiscript",
  "version": "1.0.0",
  "private": true,
  "description": "Compilador de Compiscript a ensamblador MIPS32 ejecutable en MARS 4.5",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gen": "antlr-ng -Dlanguage=TypeScript --generate-visitor --generate-listener false -o src/frontend/gen grammar/Compis.g4",
    "prepare": "npm run gen",
    "check": "tsc --noEmit",
    "compis": "tsx src/cli.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "antlr-ng": "^1.0.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "antlr4ng": "^3.0.16"
  }
}
